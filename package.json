{
  "name": "foundry-api",
  "version": "1.0.0",
  "description": "Modular monolith API for investor networking and conversation booking",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "npm run db-migrate && node src/server.js",
    "db-migrate": "npx sequelize-cli db:migrate --config ./src/shared/config/sequelize-cli.config.cjs",
    "db-migrate-undo": "npx sequelize-cli db:migrate:undo --config ./src/shared/config/sequelize-cli.config.cjs",
    "db-migrate-undo-all": "npx sequelize-cli db:migrate:undo:all --config ./src/shared/config/sequelize-cli.config.cjs",
    "db-seed-all": "npx sequelize-cli db:seed:all --config ./src/shared/config/sequelize-cli.config.cjs",
    "db-seed-undo": "npx sequelize-cli db:seed:undo --config ./src/shared/config/sequelize-cli.config.cjs",
    "db-seed-undo-all": "npx sequelize-cli db:seed:undo:all --config ./src/shared/config/sequelize-cli.config.cjs"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
